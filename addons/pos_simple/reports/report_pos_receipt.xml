<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_pos_receipt" model="ir.actions.report">
        <field name="name">Struk Penjualan</field>
        <field name="model">pos.order.simple</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_simple.report_pos_receipt</field>
        <field name="report_file">pos_simple.report_pos_receipt</field>
        <field name="binding_model_id" ref="model_pos_order_simple" />
        <field name="paperformat_id" ref="base.paperformat_us" />
    </record>

    <!-- Template Struk -->
    <template id="report_pos_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.internal_layout">
                    <div class="page">
                        <!-- Header Struk -->
                        <div class="text-center">
                            <h2>STRUK PENJUALAN</h2>
                            <h4>
                                <span t-field="doc.name" />
                            </h4>
                        </div>
                        <hr />

                        <!-- Info Transaksi -->
                        <table class="table table-sm" style="width:60%">
                            <tr>
                                <td>
                                    <strong>Tanggal</strong>
                                </td>
                                <td>
                                    <span t-field="doc.date"
                                        t-options='{"format": "dd/MM/yyyy HH:mm"}' />
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Kasir</strong>
                                </td>
                                <td>
                                    <span t-field="doc.cashier_id" />
                                </td>
                            </tr>
                            <tr t-if="doc.customer_name">
                                <td>
                                    <strong>Pelanggan</strong>
                                </td>
                                <td>
                                    <span t-field="doc.customer_name" />
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Status</strong>
                                </td>
                                <td>
                                    <span t-field="doc.state" />
                                </td>
                            </tr>
                        </table>

                        <br />

                        <!-- Daftar Belanja -->
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>Produk</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Harga</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-esc="line_index + 1" />
                                        </td>
                                        <td>
                                            <span t-field="line.product_id" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.qty" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit"
                                                t-options='{"widget": "monetary"}' />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.subtotal"
                                                t-options='{"widget": "monetary"}' />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Ringkasan Pembayaran -->
                        <table class="table" style="width:40%; float:right;">
                            <tr>
                                <td>
                                    <strong>Total</strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                        <span t-field="doc.amount_total"
                                            t-options='{"widget": "monetary"}' />
                                    </strong>
                                </td>
                            </tr>
                            <tr>
                                <td>Dibayar</td>
                                <td class="text-end">
                                    <span t-field="doc.amount_paid"
                                        t-options='{"widget": "monetary"}' />
                                </td>
                            </tr>
                            <tr>
                                <td>Kembalian</td>
                                <td class="text-end">
                                    <span t-field="doc.amount_change"
                                        t-options='{"widget": "monetary"}' />
                                </td>
                            </tr>
                        </table>

                        <div style="clear:both;"></div>

                        <!-- Footer -->
                        <br />
                        <br />
                        <div class="text-center">
                            <p>--- Terima kasih atas kunjungan Anda ---</p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>