<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- ============ TREE VIEW ============ -->
    <record id="view_pos_order_tree" model="ir.ui.view">
        <field name="name">pos.order.simple.tree</field>
        <field name="model">pos.order.simple</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'paid'"
                decoration-muted="state == 'cancelled'">
                <field name="name" />
                <field name="date" />
                <field name="cashier_id" />
                <field name="customer_name" />
                <field name="amount_total" sum="Total Penjualan" />
                <field name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'confirmed'"
                    decoration-success="state == 'paid'"
                    decoration-danger="state == 'cancelled'" />
            </tree>
        </field>
    </record>

    <!-- ============ FORM VIEW ============ -->
    <record id="view_pos_order_form" model="ir.ui.view">
        <field name="name">pos.order.simple.form</field>
        <field name="model">pos.order.simple</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Tombol aksi sesuai status -->
                    <button name="action_confirm"
                        string="Konfirmasi"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'" />
                    <button name="action_pay"
                        string="Bayar"
                        type="object"
                        class="btn-success"
                        invisible="state != 'confirmed'" />
                    <button name="action_cancel"
                        string="Batalkan"
                        type="object"
                        class="btn-danger"
                        invisible="state not in ('draft', 'confirmed')" />
                    <button name="action_set_to_draft"
                        string="Reset ke Draft"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'cancelled'" />

                    <!-- Status bar -->
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed,paid" />
                </header>

                <sheet>
                    <!-- Banner peringatan jika dibatalkan -->
                    <div class="alert alert-danger" role="alert"
                        invisible="state != 'cancelled'">
                        <strong>Order ini telah dibatalkan.</strong>
                        <field name="cancel_reason" nolabel="1"
                            invisible="not cancel_reason" />
                    </div>

                    <group>
                        <group string="Info Order">
                            <field name="name" />
                            <field name="date" />
                            <field name="cashier_id" />
                            <field name="customer_name"
                                placeholder="Opsional — kosongkan jika umum" />
                        </group>
                        <group string="Pembayaran">
                            <field name="amount_total" />
                            <field name="amount_paid"
                                readonly="state == 'paid'" />
                            <field name="amount_change" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Daftar Belanja" name="lines">
                            <field name="line_ids"
                                readonly="state in ('paid', 'cancelled')">
                                <tree editable="bottom">
                                    <field name="product_id" />
                                    <field name="qty" />
                                    <field name="price_unit" />
                                    <field name="subtotal" />
                                </tree>
                            </field>
                        </page>
                        <page string="Catatan" name="notes">
                            <field name="notes"
                                placeholder="Catatan tambahan..." />
                        </page>
                    </notebook>
                </sheet>

                <!-- Mail Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"
                        widget="mail_followers" />
                    <field name="activity_ids"
                        widget="mail_activity" />
                    <field name="message_ids"
                        widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <!-- ============ SEARCH VIEW ============ -->
    <record id="view_pos_order_search" model="ir.ui.view">
        <field name="name">pos.order.simple.search</field>
        <field name="model">pos.order.simple</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="customer_name" />
                <field name="cashier_id" />
                <separator />
                <filter string="Hari Ini"
                    name="filter_today"
                    domain="[('date', '&gt;=',
                                  (context_today()).strftime('%Y-%m-%d 00:00:00')),
                                 ('date', '&lt;=',
                                  (context_today()).strftime('%Y-%m-%d 23:59:59'))]" />
                <filter string="Sudah Dibayar"
                    name="filter_paid"
                    domain="[('state', '=', 'paid')]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter string="Kasir"
                        name="group_cashier"
                        context="{'group_by': 'cashier_id'}" />
                    <filter string="Status"
                        name="group_state"
                        context="{'group_by': 'state'}" />
                    <filter string="Tanggal"
                        name="group_date"
                        context="{'group_by': 'date:day'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- ============ ACTION ============ -->
    <record id="action_pos_order_simple" model="ir.actions.act_window">
        <field name="name">POS Orders</field>
        <field name="res_model">pos.order.simple</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>

    <!-- ============ MENU ============ -->
    <menuitem id="menu_pos_simple_root"
        name="POS Simple"
        sequence="25" />

    <menuitem id="menu_pos_simple_orders"
        name="Transaksi"
        parent="menu_pos_simple_root"
        action="action_pos_order_simple"
        sequence="10" />
</odoo>