<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_pos_order_cancel_wizard" model="ir.ui.view">
        <field name="name">pos.order.cancel.wizard.form</field>
        <field name="model">pos.order.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Pembatalan Order">
                <group>
                    <field name="order_id" readonly="1" />
                    <field name="reason"
                        placeholder="Masukkan alasan pembatalan..." />
                </group>
                <footer>
                    <button name="action_confirm_cancel"
                        string="Konfirmasi Batal"
                        type="object"
                        class="btn-danger" />
                    <button string="Kembali"
                        class="btn-secondary"
                        special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>