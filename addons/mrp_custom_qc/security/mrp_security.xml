<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- mrp cost approver(manager) -->
         <record id="group_mrp_cost_approver" model="res.groups">
            <field name="name">MRP Cost Approver (Manager)</field>
            <field name="category_id" ref="base.module_category_manufacturing_manufacturing"/>
            <field name="implied_ids" evals="[(4, ref('mrp.group_mrp_user'))]"/>
         </record>
        <!-- 2. Record Rule (ir.rule): Memastikan User Produksi & Manager bisa mengakses MO -->

         <record id="rule_mrp_production_cost_control" model="ir.rule">
            <field name="name">MRP Production: Cost Control Rule</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mrp_cost_approver')), (4, ref('mrp.group_mrp_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>