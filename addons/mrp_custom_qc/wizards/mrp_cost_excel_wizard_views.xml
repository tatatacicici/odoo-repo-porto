<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mrp_cost_excel_wizard_form" model="ir.ui.view">
            <field name="name">mrp.cost.excel.wizard.form</field>
            <field name="model">mrp.cost.excel.wizard</field>
            <field name="arch" type="xml">
                <form string="Export Laporan HPP Produksi (Excel)">
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="state_filter"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_export_excel" string="Download Excel (.xlsx)" type="object" class="btn-primary"/>
                        <button string="Batal" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_mrp_cost_excel_wizard" model="ir.actions.act_window">
            <field name="name">Laporan HPP Produksi (Excel)</field>
            <field name="res_model">mrp.cost.excel.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Tambahkan Menu di dalam Manufacturing -> Reporting -->
        <menuitem id="menu_mrp_cost_excel_report"
                  name="Laporan HPP Produksi (Excel)"
                  parent="mrp.menu_mrp_reporting"
                  action="action_mrp_cost_excel_wizard"
                  sequence="50"/>
    </data>
</odoo>